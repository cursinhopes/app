{
  "name": "app-cursinhopes",
  "version": "0.0.10",
  "type": "module",
  "description": "Aplicativo Cursinho PES",
  "main": "index.js",
  "scripts": {
    "build": "tsc && vite build",
    "android:debug": "npm run build && npx cap sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && npx cap sync && cd android && ./gradlew bundleRelease",
    "android:clean": "cd android && ./gradlew clean",
    "dev": "vite",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint",
    "assets:pwa": "capacitor-assets generate --pwa && mv icons public/icons && sed -i 's#\\.\\./icons/#icons/#g' public/manifest.json"
  },
  "keywords": [],
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "axios": "^1.20.0",
    "ionicons": "^8.1.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "@testing-library/dom": ">=7.21.4",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "cypress": "^13.5.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "sharp@0.32.6": true
  }
}
