{
  "name": "app-cursinhopes",
  "version": "0.0.10",
  "type": "module",
  "description": "Aplicativo Cursinho PES",
  "main": "index.js",
  "scripts": {
    "build": "tsc && vite build",
    "android:debug": "npm run build && npx cap sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && npx cap sync && cd android && ./gradlew bundleRelease",
    "android:clean": "cd android && ./gradlew clean",
    "dev": "vite",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint",
    "assets:pwa": "capacitor-assets generate --pwa && mv icons public/icons && sed -i 's#\\.\\./icons/#icons/#g' public/manifest.json"
  },
  "keywords": [],
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/react": "^9.0.3",
    "@ionic/react-router": "^9.0.3",
    "axios": "^1.20.0",
    "ionicons": "^8.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@testing-library/dom": ">=7.31.2",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^13.17.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^22.1.0",
    "sass-embedded": "^1.104.1",
    "terser": "^5.51.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "sharp@0.32.6": true,
    "cypress@13.17.0": true,
    "core-js@3.50.0": true
  }
}
