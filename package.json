{
  "name": "app-cursinhopes",
  "version": "0.1.0",
  "type": "module",
  "description": "Aplicativo Cursinho PES",
  "main": "index.js",
  "scripts": {
    "build": "tsc && vite build",
    "android:debug": "npm run build && npx cap sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run build && npx cap sync && cd android && ./gradlew bundleRelease",
    "android:clean": "cd android && ./gradlew clean",
    "dev": "vite",
    "preview": "vite preview",
    "test.e2e": "cypress run",
    "test.unit": "vitest",
    "lint": "eslint",
    "assets:pwa": "capacitor-assets generate --pwa && mv icons public/icons && sed -i 's#\\.\\./icons/#icons/#g' public/manifest.json"
  },
  "keywords": [],
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/barcode-scanner": "^3.1.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@ionic/react": "^9.0.3",
    "@ionic/react-router": "^9.0.3",
    "axios": "^1.20.0",
    "ionicons": "^8.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": ">=7.31.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "patch-package": "^8.0.1",
    "sass-embedded": "^1.104.1",
    "terser": "^5.51.2",
    "typescript": "npm:@typescript/typescript6@^6.0.3",
    "typescript-eslint": "^8.70.0",
    "typescript-native": "npm:typescript@latest",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "xcode": "apache/cordova-node-xcode#1edf7059d347beb0e339d1cb4741581352b43138",
    "@capacitor/assets": {
      "sharp": "0.35.4"
    }
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "sharp": true,
    "cypress": true,
    "core-js": true
  }
}
